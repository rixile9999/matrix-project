{
	admin off
	auto_https disable_redirects
	skip_install_trust
}
(matrix_app) {
	reverse_proxy 127.0.0.1:5183 {
		header_up X-Matrix-Proto {scheme}
		header_up X-Matrix-Host {hostport}
	}
}
http://localhost:5173, http://127.0.0.1:5173 {
	bind 127.0.0.1 [::1]
	import matrix_app
}
https://{$MATRIX_LAN_IP}:8443 {
	bind {$MATRIX_LAN_IP}
	tls internal
	import matrix_app
}
http://{$MATRIX_LAN_IP}:5173 {
	bind {$MATRIX_LAN_IP}
	redir https://{$MATRIX_LAN_IP}:8443{uri} 308
}
